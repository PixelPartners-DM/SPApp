@page "/createuser"

@inject PixelPalApp.Services.ApiService Api
@inject NavigationManager NavigationManager

<h1>Create User</h1>

<div class="login-box">

    <div class="form-group">
        <label>Full Name</label>
        <input @bind="fullName" placeholder="Your Name" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input @bind="email" type="email" placeholder="Your Email" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input @bind="password" type="password" placeholder="Choose Password" />
    </div>

    <div class="form-group">
        <label>Confirm Password</label>
        <input @bind="confirmPassword" type="password" placeholder="Confirm Password" />
    </div>

    <div class="form-group">
        <label>Phone Number</label>
        <input @bind="phoneNumber" placeholder="Your Phone Number" />
    </div>

    <div class="form-group">
        <label>Address</label>
        <input @bind="address" placeholder="Your Address" />
    </div>

    <button @onclick="HandleCreateUser">
        Create User
    </button>

    <button @onclick="GoToLogin">
        Back to Login
    </button>

    @if (!string.IsNullOrEmpty(message))
    {
        <p>@message</p>
    }

</div>

@code {

    private string fullName = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string phoneNumber = "";
    private string address = "";
    private string message = "";

    // Opret bruger
    private async Task HandleCreateUser()
    {
        message = "";

        // Tjek om felter mangler
        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            message = "Name, email, and password are required.";
            return;
        }

        if (password != confirmPassword)
        {
            message = "Password and confirm password do not match.";
            return;
        }

        // Opret DTO objekt
        var newUser = new SPApp.Dto.CreateUserDto
        {
            FullName = fullName,
            Email = email.Trim(),
            PasswordHash = password,
            PhoneNumber = phoneNumber,
            Address = address
        };

        // Kald API
        var result = await Api.CreateUserAsync(newUser);

        // Hvis API returnerer fejl
        if (result != "OK")
        {
            message = result;
            return;
        }

        // Success
        message = "User created successfully!";

        await Task.Delay(2000);

        // Gå tilbage til login
        NavigationManager.NavigateTo("/login");
    }

    // Tilbage til login
    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}