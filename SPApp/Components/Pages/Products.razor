@page "/products"
@using SPApp.Dto
@inject PixelPalApp.Services.ApiService Api
@inject PixelPalApp.Services.CartService Cart
@inject NavigationManager NavigationManager

<div class="page">

    <h1>Products</h1>

    @if (isLoading)
    {
        <p>Loading products...</p>
    }
    else if (!string.IsNullOrEmpty(message))
    {
        <p>@message</p>
    }
    else if (products == null || !products.Any())
    {
        <p>No products found.</p>
    }
    else
    {
        <div class="products">

            @foreach (var p in products)
            {
                <div class="product-card">

                    <h3>@p.ProductName</h3>

                    @if (p.ImageUrls != null && p.ImageUrls.Any())
                    {
                        <div class="product-images">
                            @foreach (var imageUrl in p.ImageUrls)
                            {
                                <img src="@imageUrl" alt="@p.ProductName" />
                            }
                        </div>
                    }

                    <p>Price: @p.Price.ToString("C")</p>

                    <div class="qty-row">

                        <label>Qty:</label>

                        <input type="number"
                               min="1"
                               value="@GetDesiredQuantity(p.ProductId)"
                               @onchange="(e) => SetDesiredQuantity(p.ProductId, Parseint(e.Value?.ToString()))" />

                        <button @onclick="() => AddToCart(p)">
                            Add to cart
                        </button>

                    </div>

                </div>
            }

        </div>
    }

    <div class="cart-box">

        <h4>Your Cart</h4>

        @if (!Cart.GetItems().Any())
        {
            <p>Your cart is empty</p>
        }
        else
        {
            <div class="cart-items">

                @foreach (var it in Cart.GetItems())
                {
                    <div class="cart-item">

                        <div>
                            <strong>@it.ProductName</strong>
                            <p>@it.Price.ToString("C")</p>
                        </div>

                        <div class="cart-qty">

                            <label>Qty</label>

                            <input type="number"
                                   min="1"
                                   value="@it.Quantity"
                                   @onchange="(e) => UpdateCartQty(it.ProductId, Parseint(e.Value?.ToString()))" />

                        </div>

                        <div>

                            <strong>
                                @((it.Price * it.Quantity).ToString("C"))
                            </strong>

                            <button @onclick="() => RemoveFromCart(it.ProductId)">
                                Remove
                            </button>

                        </div>

                    </div>
                }

                <div class="cart-total">
                    <strong>Total:</strong>
                    <strong>@Cart.GetTotal().ToString("C")</strong>
                </div>

            </div>

            <div class="cart-actions">
                <button @onclick="GoToConfirm">Confirm Order</button>
                <button @onclick="ClearCart">Clear cart</button>
            </div>
        }

    </div>

    <button class="back-button" @onclick="GoToUserPage">
        Back to profile
    </button>

</div>

@code {

    private List<ProductDto> products = new();
    private bool isLoading = true;
    private string? message;

    private readonly Dictionary<int, int> desiredQuantities = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        message = null;

        Cart.CartChanged += OnCartChanged;

        try
        {
            var result = await Api.GetProductsAsync();

            if (result == null)
            {
                message = "Failed to load products.";
            }
            else
            {
                products = result;

                foreach (var p in products)
                {
                    try
                    {
                        var images = await Api.GetProductImagesAsync(p.ProductId);

                        if (images != null && images.Any())
                        {
                            p.ImageUrls = images.Select(i => i.ImageUrl).ToList();
                        }
                        else
                        {
                            p.ImageUrls = new List<string>();
                        }
                    }
                    catch
                    {
                        p.ImageUrls = new List<string>();
                    }

                    desiredQuantities[p.ProductId] = 1;
                }
            }
        }
        catch
        {
            message = "Error loading products.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cart.CartChanged -= OnCartChanged;
    }

    private void GoToUserPage()
    {
        NavigationManager.NavigateTo("/userpage");
    }

    private void GoToConfirm()
    {
        NavigationManager.NavigateTo("/confirmorder");
    }

    private void AddToCart(ProductDto? product)
    {
        if (product == null)
            return;

        var qty = GetDesiredQuantity(product.ProductId);

        Cart.AddProduct(new ProductDto
        {
            ProductId = product.ProductId,
            ProductName = product.ProductName,
            Price = product.Price,
            CategoryId = product.CategoryId,
            ImageUrls = product.ImageUrls
        }, qty);
    }

    private int GetDesiredQuantity(int productId)
        => desiredQuantities.TryGetValue(productId, out var q) && q > 0 ? q : 1;

    private void SetDesiredQuantity(int productId, int qty)
    {
        desiredQuantities[productId] = qty <= 0 ? 1 : qty;
    }

    private void UpdateCartQty(int productId, int qty)
    {
        Cart.UpdateQuantity(productId, qty <= 0 ? 1 : qty);
    }

    private void RemoveFromCart(int productId)
    {
        Cart.Remove(productId);
    }

    private void ClearCart()
    {
        Cart.Clear();
    }

    private static int Parseint(string? s)
    {
        return int.TryParse(s, out var n) ? n : 1;
    }
}