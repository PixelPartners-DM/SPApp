@page "/confirmorder"
@using SPApp.Dto
@inject PixelPalApp.Services.ApiService Api
@inject PixelPalApp.Services.CartService Cart
@inject NavigationManager NavigationManager

<div class="page">

    <h1>Confirm Order</h1>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (!string.IsNullOrEmpty(message))
    {
        <p>@message</p>
    }
    else
    {
        var items = Cart.GetItems();

        if (!items.Any())
        {
            <div class="confirm-box">

                <p>Your cart is empty.</p>

                <button class="full-button" @onclick="GoToProducts">
                    Back to products
                </button>

            </div>
        }
        else
        {
            <div class="confirm-box">

                <div class="confirm-items">

                    @foreach (var it in items)
                    {
                        <div class="confirm-item">

                            <div>
                                <strong>@it.ProductName</strong>
                                <p>@it.Price.ToString("C")</p>
                            </div>

                            <div>
                                <p>Qty: @it.Quantity</p>
                                <strong>
                                    @((it.Price * it.Quantity).ToString("C"))
                                </strong>
                            </div>

                        </div>
                    }

                </div>

                <div class="confirm-total">
                    <strong>Total:</strong>
                    <strong>@Cart.GetTotal().ToString("C")</strong>
                </div>

                <p class="delivery-text">
                    Delivery: Standard
                </p>

                <div class="confirm-actions">

                    <button @onclick="GoToProducts">
                        Back
                    </button>

                    <button @onclick="ClearCart">
                        Clear cart
                    </button>

                    <button @onclick="ConfirmOrderMethod">
                        Confirm order
                    </button>

                </div>

            </div>
        }
    }

</div>

@code {
    private bool isLoading = true;
    private string? message;
    private string shippingAddress = "";
    private int deliveryId = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        message = null;

        try
        {
            var user = await Api.GetCurrentUserAsync();
        }
        catch
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToProducts()
    {
        NavigationManager.NavigateTo("/products");
    }

    private void ClearCart()
    {
        Cart.Clear();
        message = "Cart cleared.";
    }

    private async Task ConfirmOrderMethod()
    {
        message = null;

        var items = Cart.GetItems().ToList();

        if (!items.Any())
        {
            message = "Your cart is empty.";
            return;
        }

        var user = await Api.GetCurrentUserAsync();

        var order = new OrderRequestDto
        {
            OrderDate = DateTime.UtcNow,
            DeliveryId = deliveryId,

            Products = items.Select(i => new OrderProductDto
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity
            }).ToList()
        };

        var result = await Api.CreateOrderAsync(order);

        if (result == null)
        {
            message = "Failed to create order.";
            return;
        }

        Cart.Clear();

        message = $"Order placed (#{result.OrderId})";

        NavigationManager.NavigateTo("/userpage");
    }
}