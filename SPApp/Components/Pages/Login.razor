@page "/login"



<h1>Login</h1>


<!-- Container til hele login boksen -->
<div class="login-box">

    <!-- Email felt -->
    <div class=" form-group">
        <label>Email</label>
        <!-- @bind kobler input til variablen "email" -->
        <input @bind="email" type="email" placeholder="Type your email" />
    </div>

    <!-- Password felt -->
  <div class=" form-group">
        <label>Password</label>
        <!-- type="password" skjuler teksten -->
        <input @bind="password" type="password" placeholder="Type your password" />
    </div>

    <!-- Knap som kalder HandleLogin() -->
    <button @onclick="HandleLogin">Log in</button>


@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

</div>

@code {
    // Variabler til input felterne
    private string email = "";
    private string password = "";

    // Bruges til fejl/feedback til bruger
    private string message = "";

    // Metode der kører når man klikker på knappen
    private void HandleLogin()
    {

        // Tjek om felter er tomme
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            message = "Type email and password .";
            return;
        }

        // Fake login besked
        message = $"Welcome, {email}!";
    }
}



