@page "/userpage"
@using SPApp.Dto
@using System.Net.Http.Headers
@using Microsoft.Maui.Storage
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="page">

    <h3>My Profile</h3>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    @if (user == null)
    {
        <p>Loading...</p>
    }
    else if (isEditing)
    {
        <div class="edit-animation">

            <input @bind="editUser.FullName" placeholder="Full name" />
            <input @bind="editUser.Email" placeholder="Email" />
            <input @bind="editUser.PhoneNumber" placeholder="Phone number" />
            <input @bind="editUser.Address" placeholder="Address" />

            <button @onclick="ShowConfirmPopup">
                Save changes
            </button>

            <button @onclick="CancelEdit">
                Cancel
            </button>

        </div>
    }
    else
    {
        <p><strong>Name:</strong> @user.FullName</p>

        <p><strong>Email:</strong> @user.Email</p>

        <p><strong>Phone:</strong> @user.PhoneNumber</p>

        <p><strong>Address:</strong> @user.Address</p>

        <button @onclick="StartEdit">
            Edit profile
        </button>

        <button @onclick="GoToProducts">
            Browse products
        </button>

        <button @onclick="GoToOrderDetails">
            My orders
        </button>

        <button class="logout-btn" @onclick="Logout">
            Log out
        </button>
    }

</div>

@if (showConfirmPopup)
{
    <div class="popup-overlay">

        <div class="popup-box">

            <h4>Confirm changes</h4>

            <p>
                Are you sure you want to save your changes?
            </p>

            <button @onclick="SaveChanges">
                Yes, save
            </button>

            <button @onclick="CancelPopup">
                Cancel
            </button>

        </div>

    </div>
}

@if (showSuccessPopup)
{
    <div class="popup-overlay">

        <div class="popup-box">

            <h4>Success</h4>

            <p>
                Your profile was updated successfully!
            </p>

            <button @onclick="CloseSuccessPopup">
                OK
            </button>

        </div>

    </div>
}

@code {

    private UserDto? user;

    private UpdateUserDto editUser = new();

    private bool isEditing = false;

    private bool showConfirmPopup = false;

    private bool showSuccessPopup = false;

    private string errorMessage = "";

    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        var token = await SecureStorage.GetAsync("jwt_token");

        if (string.IsNullOrWhiteSpace(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        try
        {
            user = await Http.GetFromJsonAsync<UserDto>("api/User/me");
        }
        catch (Exception ex)
        {
            errorMessage = "Could not load user information.";

            Console.WriteLine(ex.Message);
        }
    }

    private void StartEdit()
    {
        if (user == null)
            return;

        editUser = new UpdateUserDto
        {
            UserId = user.UserId,
            FullName = user.FullName,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            Address = user.Address,
            PasswordHash = ""
        };

        isEditing = true;
    }

    private void ShowConfirmPopup()
    {
        showConfirmPopup = true;
    }

    private void CancelPopup()
    {
        showConfirmPopup = false;
    }

    private void CloseSuccessPopup()
    {
        showSuccessPopup = false;
    }

    private async Task SaveChanges()
    {
        if (user == null)
            return;

        showConfirmPopup = false;

        var response =
            await Http.PutAsJsonAsync($"api/User/{user.UserId}", editUser);

        if (response.IsSuccessStatusCode)
        {
            showSuccessPopup = true;

            isEditing = false;

            await LoadUser();
        }
        else
        {
            message = "Could not update profile.";
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private void GoToProducts()
    {
        NavigationManager.NavigateTo("/products");
    }

    private void GoToOrderDetails()
    {
        NavigationManager.NavigateTo("/userorderdetails");
    }

    private async Task Logout()
    {
        SecureStorage.Remove("jwt_token");

        SecureStorage.Remove("user_role");

        await Task.Delay(100);

        NavigationManager.NavigateTo("/login");
    }
}