@page "/userpage"
@using SPApp.Dto
@using System.Net.Http.Headers
@using Microsoft.Maui.Storage
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h3>Min Profil</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red">@errorMessage</p>
}

@if (user == null)
{
    <p>Indlæser...</p>
}
else if (isEditing)
{
    <input @bind="editUser.FullName" placeholder="Navn" />
    <input @bind="editUser.Email" placeholder="Email" />
    <input @bind="editUser.PhoneNumber" placeholder="Telefon" />
    <input @bind="editUser.Address" placeholder="Adresse" />

    <button @onclick="SaveChanges">Gem ændringer</button>
    <button @onclick="CancelEdit">Annuller</button>
}
else
{
    <p><strong>Navn:</strong> @user.FullName</p>
    <p><strong>Email:</strong> @user.Email</p>
    <p><strong>Telefon:</strong> @user.PhoneNumber</p>
    <p><strong>Adresse:</strong> @user.Address</p>

    <button @onclick="StartEdit">Rediger profil</button>
    <button @onclick="GoToProducts">Browse products</button>
    <button @onclick="GoToOrderDetails">My orders</button>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <p>@message</p>
}

@code {
    private UserDto? user;
    private UpdateUserDto editUser = new();

    private bool isEditing = false;
    private string errorMessage = "";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        var token = await SecureStorage.GetAsync("jwt_token");

        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "Ingen token fundet. Log ind igen.";
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        try
        {
            user = await Http.GetFromJsonAsync<UserDto>("api/User/me");
        }
        catch (Exception ex)
        {
            errorMessage = "Kunne ikke hente brugeroplysninger.";
            Console.WriteLine(ex.Message);
        }
    }

    private void StartEdit()
    {
        if (user == null)
            return;

        editUser = new UpdateUserDto
        {
            UserId = user.UserId,
            FullName = user.FullName,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            Address = user.Address,
            PasswordHash = ""
        };

        isEditing = true;
    }

    private async Task SaveChanges()
    {
        if (user == null)
            return;

        var response = await Http.PutAsJsonAsync($"api/User/{user.UserId}", editUser);

        if (response.IsSuccessStatusCode)
        {
            message = "Profil opdateret!";
            isEditing = false;
            await LoadUser();
        }
        else
        {
            message = "Kunne ikke opdatere profil.";
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private void GoToProducts()
    {
        NavigationManager.NavigateTo("/products");
    }

    private void GoToOrderDetails()
    {
        NavigationManager.NavigateTo("/userorderdetails");
    }
}