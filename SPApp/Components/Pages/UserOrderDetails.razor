@page "/userorderdetails"
@using System.Net.Http.Headers
@using SPApp.Dto
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="page">

    <h1>My Orders</h1>

    @if (orders == null)
    {
        <p>Loading orders...</p>
    }
    else if (!orders.Any())
    {
        <p>You have no orders.</p>
    }
    else
    {
        <div class="orders-list">
            @foreach (var order in orders)
            {
                <div class="order-card">
                    <p><strong>Order ID:</strong> @order.OrderId</p>
                    <p><strong>Date:</strong> @order.OrderDate.ToString("dd-MM-yyyy HH:mm")</p>
                    <p><strong>Status:</strong> @order.DeliveryStatus</p>
                    <p><strong>Address:</strong> @order.DeliveryAddress</p>
                    <p><strong>Total Price:</strong> @order.TotalPrice.ToString("C", new System.Globalization.CultureInfo("da-DK"))</p>

                    <h4>Products</h4>

                    @foreach (var item in order.OrderProducts)
                    {
                        <div class="order-product-line">
                            <div>
                                <strong>@item.Product.ProductName</strong>
                                <p>
                                    @item.Product.Price.ToString("C", new System.Globalization.CultureInfo("da-DK"))
                                    - Qty: x @item.Quantity
                                </p>
                            </div>

                            @if (item.Product.ImageUrls != null && item.Product.ImageUrls.Any())
                            {
                                <img src="@item.Product.ImageUrls.First()" />
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <button class="back-button" @onclick="GoBack">Go Back</button>

</div>

@code {
    private List<OrderDto>? orders;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        var token = await SecureStorage.GetAsync("jwt_token");

        // Hvis token er null eller tomt, naviger til login-siden
        if (string.IsNullOrWhiteSpace(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        // Sæt Authorization header for alle efterfølgende HTTP-anmodninger
        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        // Hent ordrer for den loggede bruger
        try
        {
            orders = await Http.GetFromJsonAsync<List<OrderDto>>("api/Orders/user");
        }
        // Hvis der opstår en fejl under indlæsning af ordrer, log fejlen og vis en tom liste
        catch (Exception ex)
        {
            Console.WriteLine("Couldn't load orders: " + ex.Message);
            orders = new List<OrderDto>();
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/userpage");
    }
}