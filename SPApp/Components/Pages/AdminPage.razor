@page "/admin"
@using SPApp.Dto
@using Microsoft.Maui.Storage
@inject PixelPalApp.Services.ApiService Api
@inject NavigationManager NavigationManager

<div class="page">

    <h1>Admin Panel</h1>

    <button class="logout-button" @onclick="Logout">
        Logout
    </button>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p>@message</p>
    }

    @if (users == null)
    {
        <p>Loading users...</p>
    }
    else
    {
        <div class="admin-users">

            @foreach (var user in users)
            {
                <div class="admin-card">

                    @if (editingUserId == user.UserId)
                    {
                        <p><strong>ID:</strong> @user.UserId</p>

                        <div class="form-group">
                            <label>Name</label>
                            <input @bind="editUser.FullName" />
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input @bind="editUser.Email" />
                        </div>

                        <div class="form-group">
                            <label>Phone</label>
                            <input @bind="editUser.PhoneNumber" />
                        </div>

                        <div class="form-group">
                            <label>Address</label>
                            <input @bind="editUser.Address" />
                        </div>

                        <div class="admin-actions">
                            <button @onclick="SaveEdit">Save</button>
                            <button @onclick="CancelEdit">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <p><strong>ID:</strong> @user.UserId</p>
                        <p><strong>Name:</strong> @user.FullName</p>
                        <p><strong>Email:</strong> @user.Email</p>
                        <p><strong>Phone:</strong> @user.PhoneNumber</p>
                        <p><strong>Address:</strong> @user.Address</p>

                        <div class="admin-actions">
                            <button @onclick="() => StartEdit(user)">
                                Edit User
                            </button>

                            <button @onclick="() => AskDelete(user.UserId)">
                                Delete User
                            </button>
                        </div>
                    }

                </div>
            }

        </div>
    }

    @if (showDeleteConfirm)
    {
        <div class="confirm-delete-box">

            <p>Are you sure you want to delete this user?</p>

            <div class="admin-actions">
                <button @onclick="ConfirmDelete">
                    Yes, delete
                </button>

                <button @onclick="CancelDelete">
                    Cancel
                </button>
            </div>

        </div>
    }

</div>

@code {
    private List<UserDto>? users;
    private string message = "";

    private int? editingUserId = null;
    private UpdateUserDto editUser = new();

    private bool showDeleteConfirm = false;
    private int userIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await Api.GetAllUsersAsync();

        if (users == null)
        {
            message = "Could not load users. Make sure you are logged in as admin.";
        }
    }

    private void StartEdit(UserDto user)
    {
        editingUserId = user.UserId;

        editUser = new UpdateUserDto
        {
            UserId = user.UserId,
            FullName = user.FullName,
            Email = user.Email ?? "",
            PhoneNumber = user.PhoneNumber,
            Address = user.Address,
            PasswordHash = ""
        };
    }

    private async Task SaveEdit()
    {
        if (editingUserId == null)
            return;

        var success = await Api.UpdateUserAsync(editingUserId.Value, editUser);

        if (success)
        {
            message = "User updated successfully";
            editingUserId = null;
            await LoadUsers();
        }
        else
        {
            message = "Could not update user";
        }
    }

    private void CancelEdit()
    {
        // Stopper redigering
        editingUserId = null;
        // nulstiller editUser
        editUser = new UpdateUserDto();
    }

    private void AskDelete(int userId)
    {
        userIdToDelete = userId;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        var success = await Api.DeleteUserAsync(userIdToDelete);

        if (success)
        {
            message = "User deleted successfully";
            showDeleteConfirm = false;
            await LoadUsers();
        }
        else
        {
            message = "Could not delete user";
        }
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
    }

    private void Logout()
    {
        SecureStorage.Remove("jwt_token");
        SecureStorage.Remove("user_role");

        NavigationManager.NavigateTo("/login");
    }
}