@using Microsoft.Maui.Storage
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SPApp</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            @if (isLoggedIn)
            {
                <NavLink class="nav-link" href="userpage">
                    <span class="bi bi-person-circle-fill-nav-menu" aria-hidden="true"></span>
                    Min Profil
                </NavLink>

                <NavLink class="nav-link" @onclick="Logout">
                    <span class="bi bi-box-arrow-out-right-nav-menu" aria-hidden="true"></span>
                    Logout
                </NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span>
                    Login
                </NavLink>
            }
        </div>

    </nav>
</div>

@code {
    private bool isLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await CheckLoginStatus();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckLoginStatus();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckLoginStatus()
    {
        var token = await SecureStorage.GetAsync("jwt_token");
        isLoggedIn = !string.IsNullOrWhiteSpace(token);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task Logout()
    {
        SecureStorage.Remove("jwt_token");

        SecureStorage.Remove("user_role");

        await Task.Delay(100);

        NavigationManager.NavigateTo("/login");
    }
}